# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project's Settings -> API Keys page.
#
# Supabase now issues "publishable" (sb_publishable_...) and "secret"
# (sb_secret_...) keys instead of the older anon/service_role JWTs. They're
# drop-in replacements with identical permissions — publishable = same
# privileges as the old anon key, secret = same privileges as the old
# service_role key. If your project only shows legacy anon/service_role
# keys, those work fine here too — just paste them into these same variables.

# Public — safe to expose to the browser (RLS is what protects your data,
# not keeping this key secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# SECRET — server-only. Bypasses RLS entirely. Never prefix this with
# NEXT_PUBLIC_, never commit it, never log it. Used only by scripts/seed.ts
# and any genuinely admin-only server route.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# SECRET — server-only. Used by src/app/api/chat/route.ts. Never exposed to
# the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if you wire up Cloudflare Turnstile on the login
# page (see PRODUCT_SETUP.md -> "Bot protection with Cloudflare Turnstile").
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SECRET — server-only. ClickPesa payment integration (see PRODUCT_SETUP.md
# -> "ClickPesa payments"). Get these from your ClickPesa Merchant
# Dashboard -> Settings -> Developers -> your application.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# The separate "Checksum Key" from the same application settings page —
# NOT the API Key above. Used to sign requests and verify webhooks.
CLICKPESA_CHECKSUM_KEY=
# Set to "true" to use ClickPesa's sandbox environment for testing.
# Real sandbox base URL: api-sandbox.clickpesa.com (NOT sandbox.clickpesa.com)
# Switch to "false" (or remove) when going live.
CLICKPESA_SANDBOX=true

# SECRET — server-only. Required by /api/admin/payments to verify Supabase JWTs.
# Get from: Supabase Dashboard -> Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=

# SECRET — server-only. Required by /api/cron/streak-reminders.
# Vercel automatically sends this in the Authorization header when it calls
# your cron endpoint. Set the same value in Vercel project settings under
# Environment Variables, and in Settings -> Cron Jobs if prompted.
CRON_SECRET=

# SECRET — server-only. Required by /api/admin/video-upload and email features.
# Get from: resend.com -> API Keys.
RESEND_API_KEY=

# SECRET — server-only. Required by /api/ussd for telco signature verification.
# Get from your Africa's Talking or Buni Mobile dashboard -> Webhooks -> Signing Secret.
USSD_GATEWAY_SECRET=
